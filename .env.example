# No actual credentials in this example. Public section: .env.local only.
# Empty public configuration is intentional local-only mode.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Legacy browser anon JWT, only when publishable key is absent:
# VITE_SUPABASE_ANON_KEY=

# Server-only section: copy these EMPTY fields to private .env, NOT .env.local.
# Never prefix private values with VITE_ or place actual secrets in this example.
# Scoped project management PAT, filled privately by the authorized operator:
SUPABASE_ACCESS_TOKEN=
# Populated from an existing verified server key by the controlled setup tool:
SUPABASE_SECRET_KEY=
# No APP_USERNAME / APP_PASSWORD is required or provisioned in invite mode.
# See docs/invite-setup.md; private files must be owned, Git-ignored and 0600.
